NODE_ENV=development
PORT=3000

# --------- API token x-api-key ---------
API_SECRET_TOKEN=your-secret-token-here

# --------- Database ---------
NEON_DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# --------- JWT generated with : openssl rand -base64 48 ---------
JWT_ACCESS_SECRET=your-secret-token-here
JWT_REFRESH_SECRET=your-secret-token-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --------- Mail Service (notisend) ---------
MAIL_SERVICE_URL=http://localhost:3000
MAIL_API_KEY=your-mail-api-key

# --------- Frontend ---------
FRONTEND_URL=http://localhost:5173

# --------- CORS - Origins allowed in prod (séparées par des virgules)
ALLOWED_ORIGINS=https://facturly.com,https://www.facturly.com